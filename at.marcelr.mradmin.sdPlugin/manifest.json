			"PropertyInspectorPath": "ui/settings.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/dial.json",
				"TriggerDescription": {
					"Rotate": "Next / previous",
					"Push": "Open in the browser",
					"Touch": "Open in the browser"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/dial/key"
				}
			]
		},
