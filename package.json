{
  "name": "mrstreamdeck",
  "version": "0.1.0",
  "private": true,
  "description": "MRadmin for the Stream Deck - your Minecraft server on your keys.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "validate": "streamdeck validate at.marcelr.mradmin.sdPlugin",
    "pack": "streamdeck pack at.marcelr.mradmin.sdPlugin --output dist --force",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.4"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.4",
    "@elgato/utils": "0.6.2",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-commonjs": "28.0.6",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.3.1",
    "@tsconfig/node24": "24.0.1",
    "@types/node": "24.10.1",
    "rollup": "4.52.5",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
